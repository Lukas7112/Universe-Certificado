{
  "name": "universe-certificados",
  "version": "0.8.7",
  "description": "Gerador de Certificados — Centro Educacional Universe",
  "author": "Lucks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "br.com.universe.certificados",
    "productName": "Gerador de Certificados Universe",
    "directories": { "output": "dist" },
    "files": ["main.js", "src/**/*", "assets/**/*"],
    "win": {
      "target": ["nsis"],
      "icon": "assets/images/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
